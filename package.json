{
  "name": "portfolio-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache && bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "bun run --bun eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typegen": "sanity schema extract --enforce-required-fields --force --path src/sanity/extract.json && sanity typegen generate"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@sanity/image-url": "2.1.1",
    "@sanity/ui": "4.2.6",
    "@sanity/vision": "6.16.0",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.3",
    "next": "^16.3.6",
    "next-sanity": "13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "6.16.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.3",
    "wrangler": "4.141.0"
  }
}
